#include <iostream>
#include <pthread.h>
#include <string.h>
#include <unistd.h>

// 1 Prozess 2 Threads 1 pipe

void* threadFct(void* arg)
{

    int* fd = (int*)arg;

    char buffer[100];
    read(fd[0], &buffer, sizeof(buffer));

    write(1, &buffer, strlen(buffer));

    return 0;

}

int main()
{
    int fd[2];
    pipe(fd);

    pthread_t secondThread;
    pthread_create(&secondThread, NULL, threadFct, fd);

    const char* name = "Alicia Jannika Backs";

    write(fd[1], name, strlen(name)+1);

    pthread_join(secondThread, NULL);

    close(fd[0]);
    close(fd[1]);

    return 0;

}
