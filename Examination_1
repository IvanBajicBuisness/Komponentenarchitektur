#include <iostream>
#include <unistd.h>
#include <wait.h>
#include <string.h>

void* threadFct(void* arg)
{
    int* fd2 = (int*) arg;

    char buffer[100];

    ssize_t n = read(fd2[0], &buffer, sizeof(buffer));

    write(1, &buffer, n);

    return 0;
}
int main()
{
    int fd1[2], fd2[2];

    pipe(fd1);
    pipe(fd2);

    pid_t pid = fork();

    if( pid < 0)
    {
        std::cout << "Fork failed." << std::endl;

    }

    else
    {
        if(pid == 0)
        {
            //child
            pthread_t secondThread;

            close(fd1[1]);
            close(fd2[1]);

            pthread_create(&secondThread, NULL, threadFct, fd2);

            char buffer[100];

            ssize_t n = read(fd1[0], &buffer, sizeof(buffer));

            write(1, &buffer, n);

            pthread_join(secondThread, NULL);

            close(fd1[0]);
            close(fd2[0]);

            return 0;

        }

        else
        {
            //parent

            close(fd1[0]);
            close(fd2[0]);

            const char* string = "Nachricht an Thread 1.";
            const char* string2 = "Nachricht an Thread 2.";

            write(fd1[1], string, strlen(string)+1);
            write(fd2[1], string2, strlen(string2)+1);

            close(fd1[1]);
            close(fd2[1]);

            wait(NULL);

            return 0;
        }
    }
}
